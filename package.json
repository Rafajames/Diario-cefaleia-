  "description": "Diário da Cefaleia — CENDOR. Plataforma de acompanhamento longitudinal de pacientes com cefaleia.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
